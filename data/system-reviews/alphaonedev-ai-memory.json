    "who_what": [
      {
        "text": "The official repository identifies AlphaOne LLC. The project is a self-hosted memory library/daemon with MCP, HTTP, and CLI interfaces, not an agent runtime.",
        "sources": [
          "readme",
          "security"
        ]
      }
    ],
    "architecture": [
      {
        "text": "The README documents embedded SQLite and PostgreSQL plus Apache AGE backends behind the memory API. The inspected Memory model carries namespace, content, lifecycle and typed-memory fields along with optional identity and evidence metadata; both backend schemas are represented in source.",
        "sources": [
          "readme",
          "model",
          "sqlite",
          "pgschema"
        ]
      },
      {
        "text": "The MCP store path is split across validation, transport, synthesis/classification and embedding modules; reads are exposed through recall and exact-keyword search tools.",
        "sources": [
          "store",
          "recall",
          "search"
        ]
      }
    ],
    "behavior": [
      {
        "text": "memory_store accepts content and namespace plus typed metadata, source and evidence fields. The README documents HTTP attestation as required by default while MCP and CLI writes remain operator-as-actor paths unless strict mode is enabled.",
        "sources": [
          "store",
          "readme",
          "security"
        ]
      },
      {
        "text": "memory_update supports partial changes and an expected-version precondition. The tool contract states omitted fields are preserved and tier movement is monotone-only; all storage conflict paths were not traced.",
        "sources": [
          "update"
        ]
      },
      {
        "text": "memory_delete is documented as a hard delete of the row and related embedding, FTS entry and links; bulk forget archives first. Complete cleanup across replicas and backups was not established.",
        "sources": [
          "delete",
          "forget"
        ]
      },
      {
        "text": "memory_recall ranks context matches and exposes candidate/reranker metadata, while memory_search is deterministic exact keyword AND search. A documented backend difference remains for tier filtering on one legacy SQLite path.",
        "sources": [
          "recall",
          "search"
        ]
      }
    ],
